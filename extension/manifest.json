{
  "manifest_version": 3,
  "name": "PickFocus (데모)",
  "version": "0.4.0",
  "description": "목적을 써야 유튜브가 열리고, 목적에 맞는 영상만 남습니다. 수업용 데모 버전입니다.",
  "permissions": ["storage", "notifications"],
  "host_permissions": ["https://www.youtube.com/*", "https://generativelanguage.googleapis.com/*"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "PickFocus 열기", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }]
}
